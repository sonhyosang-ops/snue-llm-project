# 이 파일을 .env 로 복사해서 쓰세요. 값이 없으면 config.py 의 기본값이 적용됩니다.

# ════════════════════════════════════════════════════════════════════════
#  A안 · Upstage API  (설치 간단, 답변 품질 높음 / 문서가 외부로 전송됨)
# ════════════════════════════════════════════════════════════════════════
EMBED_PROVIDER=upstage
CHAT_PROVIDER=upstage

UPSTAGE_API_KEY=up_여기에_발급받은_키를_붙여넣으세요
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_CHAT_MODEL=solar-pro2

# Upstage 임베딩은 문서용/질문용이 나뉘어 있습니다. 둘 다 4096차원, 같은 벡터 공간입니다.
UPSTAGE_EMBED_PASSAGE_MODEL=embedding-passage
UPSTAGE_EMBED_QUERY_MODEL=embedding-query
EMBED_DIM=4096
EMBED_BATCH=32

# 스캔본(이미지) PDF 를 Upstage OCR 로 읽습니다. 텍스트 PDF만 쓴다면 false 로 두세요.
USE_UPSTAGE_OCR=false

# ════════════════════════════════════════════════════════════════════════
#  B안 · 로컬 Ollama  (문서가 외부로 안 나감 / 설치 필요, PC 사양 탐)
#  위 A안 3줄(EMBED_PROVIDER, CHAT_PROVIDER, EMBED_DIM)을 아래로 바꾸면 됩니다.
# ════════════════════════════════════════════════════════════════════════
# EMBED_PROVIDER=ollama
# CHAT_PROVIDER=ollama
# EMBED_DIM=1024
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_CHAT_MODEL=exaone3.5:7.8b

# ⚠ 제공자를 바꾸면 벡터 차원이 달라져 기존 임베딩과 호환되지 않습니다.
#    반드시  python -m scripts.ingest_pdf data/raw_pdf --reset  으로 재구축하세요.

# ── 청킹 ───────────────────────────────────────────────────────────────
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# ── 토픽 자동 분류 ─────────────────────────────────────────────────────
# 높이면 분야가 잘게 쪼개지고, 낮추면 뭉뚱그려집니다. 0.55~0.72 사이에서 조정하세요.
TOPIC_ASSIGN_THRESHOLD=0.62
TOPIC_NEW_THRESHOLD=0.45
TOPIC_MIN_CLUSTER_SIZE=2

# ── 검색·생성 ──────────────────────────────────────────────────────────
RETRIEVE_TOP_K=6
# 이 값보다 유사한 근거가 없으면 LLM 을 부르지 않고 "자료에 없음"으로 답합니다.
RETRIEVE_SCORE_FLOOR=0.35
GEN_TEMPERATURE=0.1

# ── 서버 ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
