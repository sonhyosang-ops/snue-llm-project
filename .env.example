# 환경 변수 예시 파일. 이 파일을 .env.local로 복사한 뒤 실제 값을 채운다.
# .env.local은 Git에 올리지 않는다(.gitignore). Vercel에는 같은 항목을 대시보드 Environment Variables에 등록한다.

# Supabase 연결. NEXT_PUBLIC_으로 시작하는 값은 브라우저에도 전달되므로 공개 키만 둔다.
# SUPABASE_SERVICE_ROLE_KEY는 모든 데이터를 읽고 쓰는 관리자 키라 서버에서만 쓰고 절대 공개하지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Upstage API 키(문서 파싱·임베딩·답변 생성에 모두 사용)
UPSTAGE_API_KEY=your_upstage_api_key

# 이 도메인 메일이면서 allowed_users에 등록된 사용자만 로그인할 수 있다.
ALLOWED_EMAIL_DOMAIN=baegotnuri.es.kr

# 사용할 모델 이름. 바꿀 때는 명시적으로 바꾼다.
# 임베딩 모델(PASSAGE/QUERY)을 바꾸면 기존 벡터와 비교할 수 없으므로 문서를 다시 색인해야 한다.
UPSTAGE_PARSE_MODEL=document-parse
UPSTAGE_CHAT_MODEL=solar-pro4
UPSTAGE_PASSAGE_MODEL=embedding-passage
UPSTAGE_QUERY_MODEL=embedding-query
# 검색 결과로 인정할 최소 유사도(0~1). 이보다 낮은 근거는 버리고 "찾지 못했다"고 답한다.
RETRIEVAL_SCORE_FLOOR=0.35

# Vercel Cron이 /api/keepalive를 부를 때 Bearer 토큰으로 보내는 비밀값(Supabase 자동 정지 방지용 매일 접속).
CRON_SECRET=your_random_secret
