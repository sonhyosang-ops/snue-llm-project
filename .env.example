NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
UPSTAGE_API_KEY=your_upstage_api_key

# Only users listed in allowed_users with this domain can sign in.
ALLOWED_EMAIL_DOMAIN=baegotnuri.es.kr

# Keep model changes explicit. Re-index the document after changing embedding models.
UPSTAGE_PARSE_MODEL=document-parse
UPSTAGE_CHAT_MODEL=solar-pro2
UPSTAGE_PASSAGE_MODEL=embedding-passage
UPSTAGE_QUERY_MODEL=embedding-query
RETRIEVAL_SCORE_FLOOR=0.35
